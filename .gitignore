# ============================================================
# .gitignore — tells Git which files to NOT upload to GitHub
# ============================================================
# NOTE: Supabase keys (anon key + project URL) are PUBLIC by design —
# they are safe to commit because data security comes from Row Level
# Security (RLS) in the database, not from hiding the key.

# Local tooling / working files
.supabase/

# OS files (Windows/Mac)
Thumbs.db
.DS_Store

# Logs and temporary files
*.log
node_modules/

# ============================================================
# Karen Beauty React app source (only the built ./out is deployed)
# ============================================================
/karen-beauty/
.env.local